<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lance017.system.mapper.WorkBookRoleMapper">

    <resultMap type="WorkBookRole" id="WorkBookRoleResult">
        <result property="id"    column="id"    />
        <result property="bookId"    column="book_id"    />
        <result property="name"    column="name"    />
        <result property="userId"    column="user_id"    />
        <result property="sex"    column="sex"    />
        <result property="characte"    column="characte"    />
        <result property="plot"    column="plot"    />
        <result property="sort"    column="sort"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectWorkBookRoleVo">
        select id, book_id, name, user_id, sex, characte, plot, sort, status, create_by, create_time, update_by, update_time, remark from work_book_role
    </sql>

    <select id="selectWorkBookRoleList" parameterType="WorkBookRole" resultMap="WorkBookRoleResult">
        <include refid="selectWorkBookRoleVo"/>
        <where>
            <if test="bookId != null "> and book_id = #{bookId}</if>
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="sex != null "> and sex = #{sex}</if>
            <if test="characte != null  and characte != ''"> and characte = #{characte}</if>
            <if test="plot != null  and plot != ''"> and plot = #{plot}</if>
            <if test="sort != null "> and sort = #{sort}</if>
            <if test="status != null "> and status = #{status}</if>
        </where>
    </select>










</mapper>
