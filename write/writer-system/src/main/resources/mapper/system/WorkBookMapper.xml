<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lance017.system.mapper.WorkBookMapper">

    <resultMap type="WorkBook" id="WorkBookResult">
        <result property="id"    column="id"    />
        <result property="title"    column="title"    />
        <result property="synopsis"    column="synopsis"    />
        <result property="status"    column="status"    />
        <result property="userId"    column="user_id"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectWorkBookVo">
        select wb.id, title, wb.synopsis, wb.status, wb.user_id, wb.create_by, wb.create_time, wb.update_by, wb.update_time, wb.remark, (
            select IFNULL(sum(wp.words), 0) from work_book_part wp where wp.book_id = wb.id
            ) as words from work_book wb
    </sql>

    <select id="selectWorkBookList" parameterType="WorkBook" resultMap="WorkBookResult">
        <include refid="selectWorkBookVo"/>
        <where>
            <if test="title != null  and title != ''"> and wb.title = #{title}</if>
            <if test="synopsis != null  and synopsis != ''"> and wb.synopsis = #{synopsis}</if>
            <if test="status != null "> and wb.status = #{status}</if>
            <if test="userId != null "> and wb.user_id = #{userId}</if>
        </where>
        order by wb.id desc
    </select>










</mapper>
